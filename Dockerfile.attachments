FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
ENV ATTACHMENT_MODEL_CACHE=/opt/attachment-models
COPY scripts/attachment-ocr-models.cjs ./scripts/
RUN npm run attachments:ocr:prepare
COPY --chown=node:node src ./src
COPY --chown=node:node scripts ./scripts
USER node
CMD ["node", "scripts/attachment-worker.cjs"]
